# Cổng và địa chỉ lắng nghe
PORT=8787
HOST=0.0.0.0

# Bỏ trống để dùng PGlite (PostgreSQL nhúng, lưu ở .data/pglite) khi phát triển.
# Production: chuỗi kết nối PostgreSQL, ví dụ postgres://user:pass@host:5432/tptl
DATABASE_URL=

# Địa chỉ giao diện web được phép gọi API (CORS), nhiều địa chỉ cách nhau bằng dấu phẩy.
WEB_ORIGIN=http://localhost:5173

# Đăng nhập Google: OAuth 2.0 Client ID loại "Web application" (Google Cloud Console).
GOOGLE_CLIENT_ID=

# Đăng nhập Facebook: App ID và App Secret (developers.facebook.com).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
