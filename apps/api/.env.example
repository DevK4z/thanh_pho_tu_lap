# Cổng và địa chỉ lắng nghe
PORT=8787
HOST=0.0.0.0

# Bỏ trống để dùng PGlite (PostgreSQL nhúng, lưu ở .data/pglite) khi phát triển.
# Production: chuỗi kết nối PostgreSQL, ví dụ postgres://user:pass@host:5432/tptl
DATABASE_URL=

# Địa chỉ giao diện web được phép gọi API (CORS), nhiều địa chỉ cách nhau bằng dấu phẩy.
WEB_ORIGIN=http://localhost:5173

# Đăng nhập Google: OAuth 2.0 Client ID loại "Web application" (Google Cloud Console).
GOOGLE_CLIENT_ID=

# Đăng nhập Facebook: App ID và App Secret (developers.facebook.com).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Email quản trị viên ứng dụng (cách nhau bằng dấu phẩy). Đăng nhập bằng Google với email này
# sẽ thấy trang Báo cáo tỷ lệ hoàn thành và bỏ cuộc của mọi người ở mọi nhóm.
ADMIN_EMAILS=

# Khóa Gemini API (aistudio.google.com/apikey) để kiểm tra ảnh bằng chứng và câu hỏi nhớ lại.
# Để trống: ứng dụng vẫn chạy, phiên ngoài màn hình ở trạng thái "chưa xác minh", câu nhớ lại chờ người tổ chức xem.
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite

# Khóa cho workflow sao lưu tự động (ít nhất 24 ký tự, đặt cùng giá trị trong GitHub Secrets).
BACKUP_KEY=
