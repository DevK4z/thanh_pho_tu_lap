    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tptl/shared": "*",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
